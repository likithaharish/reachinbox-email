NODE_ENV=development

# Backend
PORT=5177
FRONTEND_URL=http://localhost:5178

# PostgreSQL (used via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public"

# Start BullMQ worker inside the API process (useful for free single-service deploys)
START_WORKER_IN_PROCESS=false

# Redis (BullMQ)
# Local: localhost:6379 with no password
# Upstash: use the TCP host/port/password from the Upstash dashboard (TLS is auto-enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

BULLMQ_QUEUE_NAME=reachinbox-email-scheduler
BULLMQ_WORKER_CONCURRENCY=3

# Session secret (cookie-based auth)
SESSION_SECRET="change-me"

# Google OAuth credentials (set up in Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5177/auth/google/callback"

# Ethereal SMTP (fake SMTP for testing)
ETHEREAL_SMTP_HOST="smtp.ethereal.email"
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER="your-ethereal-user"
ETHEREAL_SMTP_PASS="your-ethereal-pass"
ETHEREAL_SMTP_FROM_EMAIL="your-ethereal-user"

# Identifier used for sender grouping/rate limiting.
DEFAULT_SENDER_KEY=default

# Admin dashboard (email + password, separate from Google users)
ADMIN_EMAIL=admin@reachinbox.local
ADMIN_PASSWORD=ReachInboxAdmin123

